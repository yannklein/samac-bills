<%- include('partials/head', { title: t('edit.title', { invoice: bill.invoice_no }) }) %>
<p><a href="/bills/<%= bill.id %>"><%= t('edit.back') %></a></p>
<h1><%= t('edit.title', { invoice: bill.invoice_no }) %></h1>
<p class="muted"><%= t('edit.intro', { resend: split ? t('edit.resend') : '' }) %></p>

<form method="post" action="/bills/<%= bill.id %>/edit" class="box" id="edit-form">
  <div class="grid">
    <label><%= t('form.invoice') %> <input name="invoice_no" value="<%= bill.invoice_no %>" required></label>
    <label><%= t('form.issued') %> <input type="date" name="issued_at" value="<%= bill.issued_at || '' %>"></label>
    <label><%= t('form.from') %> <input type="date" name="period_from" value="<%= bill.period_from || '' %>" required></label>
    <label><%= t('form.to') %> <input type="date" name="period_to" value="<%= bill.period_to || '' %>" required></label>
    <label><%= t('form.days') %> <input name="days" value="<%= bill.days || '' %>" inputmode="numeric"></label>
    <label><%= t('form.kwhTotal') %> <input name="kwh_total" value="<%= fmtNum(bill.kwh_total) %>" inputmode="decimal" required></label>
    <label><%= t('form.total') %> <input name="total" id="total" value="<%= fmtNum(bill.total_cents / 100, 2) %>" inputmode="decimal" required></label>
  </div>

  <h3><%= t('edit.lines') %></h3>
  <div class="table-wrap">
  <table class="breakdown">
    <thead><tr><th><%= t('bill.colLine') %></th><th><%= t('bill.colSplit') %></th><th class="num"><%= t('form.amount') %></th></tr></thead>
    <tbody>
    <% const rows = [...bill.items, { label: '', kind: 'fixed', amountCents: null, key: 'other' }, { label: '', kind: 'fixed', amountCents: null, key: 'other' }]; %>
    <% for (const it of rows) { %>
      <tr>
        <td><input name="line_label" value="<%= it.label %>" placeholder="<%= t('edit.emptyRow') %>"><input type="hidden" name="line_key" value="<%= it.key || 'other' %>"></td>
        <td><select name="line_kind">
          <% for (const k of ['fixed', 'variable', 'tax']) { %><option value="<%= k %>" <%= it.kind === k ? 'selected' : '' %>><%= KIND_LABELS[k] %></option><% } %>
        </select></td>
        <td class="num"><input name="line_amount" class="amount" value="<%= it.amountCents == null ? '' : fmtNum(it.amountCents / 100, 2) %>" inputmode="decimal"></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  </div>
  <p id="sum-check" class="small"></p>
  <p class="muted small"><%= t('edit.removeHint') %></p>
  <button><%= t('edit.save') %></button>
</form>

<script type="module">
  import { parseAmount } from '/js/money.js';
  import { makeT, formatMoney } from '/js/i18n.js';
  const lang = <%- JSON.stringify(lang) %>;
  const t = makeT(lang);
  const form = document.getElementById('edit-form');
  const check = () => {
    const sum = [...form.querySelectorAll('.amount')].reduce((s, i) => s + (i.value.trim() ? parseAmount(i.value) : 0), 0);
    const total = parseAmount(document.getElementById('total').value);
    const ok = Number.isFinite(sum) && Math.abs(sum - total) <= 1;
    const el = document.getElementById('sum-check');
    el.textContent = `${t('form.sum', { sum: Number.isFinite(sum) ? formatMoney(sum, lang) : '?' })} ${ok ? t('form.sumOk') : t('form.sumBad')}`;
    el.className = 'small ' + (ok ? 'ok' : 'error');
  };
  form.addEventListener('input', check);
  check();
</script>
<%- include('partials/foot') %>
