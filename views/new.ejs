<%- include('partials/head', { title: 'New bill' }) %>
<p><a href="/">← Payments</a></p>
<h1>New bill (manual)</h1>
<p class="muted">For when the automation fails. Upload the Endesa PDF: the fields fill in automatically and you can correct any of them.</p>

<section class="box">
  <h3>1. Bill PDF</h3>
  <input type="file" id="pdf" accept="application/pdf">
  <p id="parse-status" class="muted small"></p>
  <ul id="parse-errors" class="error"></ul>
</section>

<form id="bill-form" method="post" action="/bills" enctype="multipart/form-data" class="box" hidden>
  <h3>2. Bill details</h3>
  <input type="hidden" name="pdf_path" id="pdf_path">
  <input type="hidden" name="items_json" id="items_json">
  <div class="grid">
    <label>Invoice no. <input name="invoice_no" id="invoice_no" required></label>
    <label>Issued <input type="date" name="issued_at" id="issued_at"></label>
    <label>From <input type="date" name="period_from" id="period_from" required></label>
    <label>To <input type="date" name="period_to" id="period_to" required></label>
    <label>Days <input name="days" id="days" inputmode="numeric"></label>
    <label>Total consumption (kWh) <input name="kwh_total" id="kwh_total" inputmode="decimal" required></label>
    <label>Bill total (€) <input name="total" id="total" inputmode="decimal" required></label>
  </div>

  <h4>Lines</h4>
  <div class="table-wrap">
  <table class="breakdown" id="items">
    <thead><tr><th>Bill line</th><th>Split</th><th class="num">Amount (€)</th><th></th></tr></thead>
    <tbody></tbody>
  </table>
  </div>
  <button type="button" class="link" id="add-item">+ Add line</button>
  <p id="sum-check" class="small"></p>

  <h3>3. Neighbor meter</h3>
  <div class="grid">
    <label>Current reading <input name="reading" id="reading" inputmode="decimal" placeholder="<%= lastReading != null ? 'previous: ' + lastReading : 'no previous reading' %>"></label>
    <label>…or neighbor kWh directly <input name="neighbor_kwh" id="neighbor_kwh" inputmode="decimal"></label>
    <label>Photo (optional) <input type="file" name="photo" accept="image/*"></label>
  </div>
  <p class="muted small">Leave it empty and the bill stays “waiting for neighbor photo”, so the WhatsApp flow can still complete it.</p>

  <h3>4. Preview</h3>
  <div id="preview" class="muted">Enter the reading or the kWh to see the split.</div>

  <button id="save">Save bill</button>
</form>

<script>window.SAMAC = { lastReading: <%- JSON.stringify(lastReading) %> };</script>
<script type="module" src="/new.js"></script>
<%- include('partials/foot') %>
