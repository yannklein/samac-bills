<%- include('partials/head', { title: t('new.title') }) %>
<p><a href="/"><%= t('bill.backPayments') %></a></p>
<h1><%= t('new.title') %></h1>
<p class="muted"><%= t('new.intro') %></p>

<section class="box">
  <h3><%= t('new.step1') %></h3>
  <input type="file" id="pdf" accept="application/pdf">
  <p id="parse-status" class="muted small"></p>
  <ul id="parse-errors" class="error"></ul>
</section>

<form id="bill-form" method="post" action="/bills" enctype="multipart/form-data" class="box" hidden>
  <h3><%= t('new.step2') %></h3>
  <input type="hidden" name="pdf_path" id="pdf_path">
  <input type="hidden" name="items_json" id="items_json">
  <div class="grid">
    <label><%= t('form.invoice') %> <input name="invoice_no" id="invoice_no" required></label>
    <label><%= t('form.issued') %> <input type="date" name="issued_at" id="issued_at"></label>
    <label><%= t('form.from') %> <input type="date" name="period_from" id="period_from" required></label>
    <label><%= t('form.to') %> <input type="date" name="period_to" id="period_to" required></label>
    <label><%= t('form.days') %> <input name="days" id="days" inputmode="numeric"></label>
    <label><%= t('form.kwhTotal') %> <input name="kwh_total" id="kwh_total" inputmode="decimal" required></label>
    <label><%= t('form.total') %> <input name="total" id="total" inputmode="decimal" required></label>
  </div>

  <h4><%= t('edit.lines') %></h4>
  <div class="table-wrap">
  <table class="breakdown" id="items">
    <thead><tr><th><%= t('bill.colLine') %></th><th><%= t('bill.colSplit') %></th><th class="num"><%= t('form.amount') %></th><th></th></tr></thead>
    <tbody></tbody>
  </table>
  </div>
  <button type="button" class="link" id="add-item"><%= t('new.addLine') %></button>
  <p id="sum-check" class="small"></p>

  <h3><%= t('new.step3', { name: names.neighbor }) %></h3>
  <div class="grid">
    <label><%= t('new.currentReading') %> <input name="reading" id="reading" inputmode="decimal" placeholder="<%= lastReading != null ? t('bill.previousPlaceholder', { reading: lastReading }) : t('new.noPrevious') %>"></label>
    <label><%= t('bill.kwhDirect', { name: names.neighbor }) %> <input name="neighbor_kwh" id="neighbor_kwh" inputmode="decimal"></label>
    <label><%= t('bill.photoOptional') %> <input type="file" name="photo" accept="image/*"></label>
  </div>
  <p class="muted small"><%= t('new.emptyHint') %></p>

  <h3><%= t('new.step4') %></h3>
  <div id="preview" class="muted"><%= t('new.previewEmpty') %></div>

  <button id="save"><%= t('new.save') %></button>
</form>

<script>window.SAMAC = <%- JSON.stringify({ lastReading, lang, names }).replace(/</g, '\\u003c') %>;</script>
<script type="module" src="/new.js"></script>
<%- include('partials/foot') %>
