<%- include('partials/head', { title: t('admin.title') }) %>
<p><a href="/"><%= t('bill.backPayments') %></a></p>
<h1><%= t('admin.title') %></h1>

<h2><%= t('admin.people') %></h2>
<p class="muted small"><%= t('admin.peopleHint') %></p>
<div class="table-wrap">
<table class="breakdown">
  <thead><tr><th><%= t('admin.role') %></th><th><%= t('admin.name') %></th><th><%= t('admin.whatsapp') %></th><th><%= t('admin.email') %></th><th></th></tr></thead>
  <tbody>
  <% for (const p of people) { const roleName = t(`role.${p.role}`); %>
    <tr>
      <td><strong><%= roleName %></strong><% if (p.missing) { %><br><small class="muted"><%= t('admin.notSet') %></small><% } %>
        <form id="person-<%= p.role %>" method="post" action="/admin/people"><input type="hidden" name="role" value="<%= p.role %>"></form></td>
      <td><input form="person-<%= p.role %>" name="name" value="<%= p.name || '' %>" placeholder="<%= t('admin.name') %>" required></td>
      <td><input form="person-<%= p.role %>" name="wa_phone" value="<%= p.wa_phone || '' %>" inputmode="tel" placeholder="34612345678"></td>
      <td><input form="person-<%= p.role %>" name="email" type="email" value="<%= p.email || '' %>" placeholder="name@example.com"></td>
      <td class="actions"><button form="person-<%= p.role %>"><%= p.missing ? t('admin.add') : t('admin.save') %></button></td>
    </tr>
    <% if (!p.missing && p.role !== 'yann') { %>
    <tr class="sub"><td colspan="5">
      <form method="post" action="/admin/people/<%= p.role %>/delete" onsubmit="return confirm(<%= JSON.stringify(t('admin.removeConfirm', { name: p.name })) %>)">
        <button class="link danger"><%= t('admin.remove', { name: p.name }) %></button>
      </form>
    </td></tr>
    <% } %>
  <% } %>
  </tbody>
</table>
</div>

<h2><%= t('admin.seed') %></h2>
<div class="box">
  <p><%= t('admin.seedText', { value: '' }) %><strong><%= seed ? fmtNum(seed.reading_kwh) : t('admin.notSet') %></strong><% if (seed) { %> <span class="muted small"><%= t('admin.seedSet', { date: seed.created_at }) %></span><% } %></p>
  <form method="post" action="/admin/seed" class="row">
    <label style="flex:1"><%= t('admin.newValue') %> <input name="reading" inputmode="decimal" required placeholder="12345"></label>
    <button><%= t('admin.save') %></button>
  </form>
  <p class="muted small"><%= t('admin.seedHint') %></p>
</div>

<h2><%= t('admin.backup') %></h2>
<div class="box">
  <p><%= t('admin.backupText') %></p>
  <a class="button secondary" href="/admin/backup"><%= t('admin.download') %></a>
</div>
<%- include('partials/foot') %>
