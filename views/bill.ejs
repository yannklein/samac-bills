<%- include('partials/head', { title: bill.invoice_no }) %>
<%
  const confirmed = readings.find((r) => r.status === 'confirmed');
  const candidate = readings.find((r) => r.status === 'candidate');
  const bd = split?.breakdown;
  const paid = Object.fromEntries(payments.map((p) => [p.payer, p]));
  const names = { neighbor: people.neighbor?.name || 'Neighbor', marcela: people.marcela?.name || 'Marcela' };
  const pct = (x) => (x * 100).toFixed(1);
%>
<p><a href="/">← Payments</a></p>
<div class="row between">
  <h1>Electricity <%= fmtDate(bill.period_from) %> – <%= fmtDate(bill.period_to) %></h1>
  <span class="badge s-<%= bill.status %>"><%= STATUS_LABELS[bill.status] %></span>
</div>
<p class="muted">Bill <%= bill.invoice_no %> · issued <%= fmtDate(bill.issued_at) %> · <%= bill.days %> days · <%= fmtKwh(bill.kwh_total) %> · <%= bill.source === 'manual' ? 'created by hand' : 'automatic' %><%= bill.status_note ? ' · ' + bill.status_note : '' %></p>

<% if (split) { %>
<section class="cards">
  <div class="card"><div class="label"><%= names.neighbor %> → Yann</div><div class="amount"><%= formatEur(split.neighbor_cents) %></div><div class="muted"><%= fmtKwh(split.neighbor_kwh) %></div>
    <% if (user.isAdmin) { %><form method="post" action="/bills/<%= bill.id %>/paid"><input type="hidden" name="payer" value="neighbor"><button class="link"><%= paid.neighbor ? '✓ Paid' : 'Mark as paid' %></button></form><% } else if (paid.neighbor) { %><div class="paid">✓ Paid</div><% } %>
  </div>
  <div class="card"><div class="label"><%= names.marcela %> → Yann (1/3 of home)</div><div class="amount"><%= formatEur(split.marcela_cents) %></div>
    <% if (user.isAdmin) { %><form method="post" action="/bills/<%= bill.id %>/paid"><input type="hidden" name="payer" value="marcela"><button class="link"><%= paid.marcela ? '✓ Paid' : 'Mark as paid' %></button></form><% } else if (paid.marcela) { %><div class="paid">✓ Paid</div><% } %>
  </div>
  <div class="card"><div class="label">Yann &amp; Adriana (2/3 of home)</div><div class="amount"><%= formatEur(split.yann_adriana_cents) %></div><div class="muted">Home total <%= formatEur(split.home_cents) %> · <%= fmtKwh(split.home_kwh) %></div></div>
</section>
<p class="muted small"><%= split.sent_at ? 'Sent on WhatsApp on ' + split.sent_at + ' UTC.' : 'Not sent on WhatsApp yet.' %> Calculated on <%= split.computed_at %> UTC.</p>

<h2>Breakdown</h2>
<div class="table-wrap">
<table class="breakdown">
  <thead><tr><th>Bill line</th><th>Split</th><th class="num">Bill</th><th class="num"><%= names.neighbor %></th><th class="num">Home</th></tr></thead>
  <tbody>
    <% for (const l of bd.lines.filter((l) => l.kind !== 'tax')) { %>
      <tr><td><%= l.label %></td><td class="muted"><%= KIND_LABELS[l.kind] %></td><td class="num"><%= formatEur(l.amountCents) %></td><td class="num"><%= formatEur(l.neighborCents) %></td><td class="num"><%= formatEur(l.homeCents) %></td></tr>
    <% } %>
    <tr class="subtotal"><td>Subtotal before taxes</td><td class="muted">ratio <%= pct(bd.taxRatioNeighbor) %>% / <%= pct(1 - bd.taxRatioNeighbor) %>%</td><td class="num"><%= formatEur(bd.pretax.total) %></td><td class="num"><%= formatEur(bd.pretax.neighbor) %></td><td class="num"><%= formatEur(bd.pretax.home) %></td></tr>
    <% for (const l of bd.lines.filter((l) => l.kind === 'tax')) { %>
      <tr><td><%= l.label %></td><td class="muted"><%= KIND_LABELS[l.kind] %></td><td class="num"><%= formatEur(l.amountCents) %></td><td class="num"><%= formatEur(l.neighborCents) %></td><td class="num"><%= formatEur(l.homeCents) %></td></tr>
    <% } %>
    <tr class="total"><td>Total</td><td></td><td class="num"><%= formatEur(bill.total_cents) %></td><td class="num"><%= formatEur(split.neighbor_cents) %></td><td class="num"><%= formatEur(split.home_cents) %></td></tr>
  </tbody>
</table>
</div>
<p class="muted small">Fixed costs split 50/50 · variable costs by kWh (<%= pct(bd.kwhShare) %>% neighbor) · taxes by the ratio of each side's subtotal · rounding goes to the home side so the total matches the bill. Line labels are as printed on the Endesa bill.</p>
<% } else { %>
  <p class="callout">No split yet: waiting for the neighbor's meter reading.<% if (candidate && candidate.reading_kwh != null) { %> Latest proposed reading: <strong><%= candidate.reading_kwh %></strong> (not confirmed yet).<% } %></p>
<% } %>

<h2>Neighbor meter readings</h2>
<p>
  Previous: <strong><%= previous ? previous.reading_kwh : '—' %></strong>
  → Current: <strong><%= confirmed ? confirmed.reading_kwh : (split?.reading_kwh ?? '—') %></strong>
  <% if (split) { %> = <strong><%= fmtKwh(split.neighbor_kwh) %></strong><% } %>
</p>

<h2>Evidence</h2>
<div class="evidence">
  <div>
    <h3>Bill</h3>
    <% if (bill.pdf_path) { %><a class="button secondary" href="/files/<%= bill.pdf_path %>" target="_blank">📄 Open PDF</a><% } else { %><span class="muted">No PDF</span><% } %>
  </div>
  <div>
    <h3>Neighbor meter (current)</h3>
    <% const photo = confirmed?.photo_path || candidate?.photo_path; %>
    <% if (photo) { %><a href="/files/<%= photo %>" target="_blank"><img src="/files/<%= photo %>" alt="Current meter"></a><% } else { %><span class="muted">No photo</span><% } %>
  </div>
  <div>
    <h3>Neighbor meter (previous)</h3>
    <% if (previous?.photo_path) { %><a href="/files/<%= previous.photo_path %>" target="_blank"><img src="/files/<%= previous.photo_path %>" alt="Previous meter"></a><% } else { %><span class="muted"><%= previous ? 'Reading ' + previous.reading_kwh + ' (no photo)' : 'No reading' %></span><% } %>
  </div>
</div>

<% if (user.isAdmin) { %>
<h2>Admin</h2>
<div class="admin">
  <form method="post" action="/bills/<%= bill.id %>/reading" enctype="multipart/form-data" class="box">
    <h3><%= split ? 'Fix the reading and recalculate' : 'Enter the reading' %></h3>
    <label>Neighbor meter reading <input name="reading" inputmode="decimal" placeholder="<%= previous ? 'previous: ' + previous.reading_kwh : '' %>"></label>
    <label>…or neighbor kWh directly <input name="neighbor_kwh" inputmode="decimal"></label>
    <label>Photo (optional) <input type="file" name="photo" accept="image/*"></label>
    <button>Calculate</button>
  </form>
  <% if (split) { %>
  <form method="post" action="/bills/<%= bill.id %>/send" class="box" onsubmit="return confirm('Send the split on WhatsApp to all 4?')">
    <h3>WhatsApp</h3>
    <p class="muted small">Sends the split message to Yann, Adriana, Marcela and the neighbor.</p>
    <button <%= n8nConfigured ? '' : 'disabled' %>>Send on WhatsApp</button>
    <% if (!n8nConfigured) { %><p class="muted small">N8N_SEND_WEBHOOK_URL is not configured.</p><% } %>
  </form>
  <% } %>
</div>
<% } %>
<%- include('partials/foot') %>
