# Copy to Coolify environment variables (never commit real values)
NODE_ENV=production
PUBLIC_URL=https://bills.yannklein.dev
ADMIN_EMAIL=yann.klein@me.com
# Long random token shared with n8n ("Samac bills API token" credential): openssl rand -hex 32
API_TOKEN=
# NIE of the Endesa contract holder (needed to download the bill PDF)
ENDESA_NIE=
# Cloudflare Access (Zero Trust > Access > Applications > bills.yannklein.dev)
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
# WhatsApp Cloud API (Meta test number)
WA_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v23.0
# n8n "Samac · Send split (manual)" production webhook + its header token
N8N_SEND_WEBHOOK_URL=https://n8n.yannklein.dev/webhook/samac-send-split
N8N_WEBHOOK_TOKEN=
